        (dummy-eddie-version-9 eddie-version)
        (dummy-agent-banner-10 agent-banner)
        (dummy-gsa-banner-11 gsa-banner)
        (dummy-eddie-banner-12 eddie-banner)
        (dummy-agent-run-13 agent-run)
        (dummy-gsa-run-14 gsa-run)
        (dummy-format-tradeoff-block-15 format-tradeoff-block)
        (dummy-make-host-request-16 make-host-request)
        (dummy-make-host-response-17 make-host-response)
        (dummy-is-valid-capability-18 is-valid-capability?)
        (dummy-is-valid-action-19 is-valid-action?)
        (dummy-host-call-20 host-call)
        (dummy-make-horizon-result-21 make-horizon-result)
        (dummy-make-item-22 make-item)
        (dummy-add-middleware-23 add-middleware)
        (dummy-run-firewall-check-24 run-firewall-check)
