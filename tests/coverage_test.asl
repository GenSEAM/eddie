        (dummy-has-traversal-32 has-traversal?)
        (dummy-is-system-path-33 is-system-path?)
        (dummy-is-in-worktrees-34 is-in-worktrees?)
        (dummy-deserialize-graph-35 deserialize-graph)
        (dummy-make-triage-decision-36 make-triage-decision)
